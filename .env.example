# Copy this file to .env  (install.bat does it for you).  NEVER share or commit your real .env.
# You can also paste keys in RANI > Settings > AI Brain (stored in Windows Credential Manager).
# RANI uses them in this order: Gemini -> Grok -> Groq -> OpenRouter -> your own cloud -> Ollama (offline).
# You do NOT need all of them - fill only the ones you have. Empty = skipped.

# 1) Google Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 2) xAI Grok (https://console.x.ai)
XAI_API_KEY=

# 3) Groq Cloud - fast, free tier (https://console.groq.com/keys)
GROQ_API_KEY=

# 4) OpenRouter - many models, some free (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# 5) Any other OpenAI-compatible cloud. Base URL + model are set in Settings > AI Brain.
OPENAI_COMPAT_API_KEY=

# Last resort (offline): Ollama. install.bat installs it and downloads the model for you - no key needed.

# Optional: where RANI keeps settings/memory/cache (default: %APPDATA%\RANI)
# RANI_HOME=
